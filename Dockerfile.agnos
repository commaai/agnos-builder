# AGNOS Void Linux build
# check=error=true

# ################## #
# ###### Base ###### #
# ################## #
FROM scratch AS agnos-base

ARG VOID_ROOTFS
ADD ${VOID_ROOTFS} /

RUN mkdir -p /tmp/agnos

ARG USERNAME=comma

COPY ./userspace/base_setup.sh /tmp/agnos/
RUN /tmp/agnos/base_setup.sh

# ################### #
# ###### AGNOS ###### #
# ################### #
FROM agnos-base

ARG USERNAME=comma
ARG XDG_DATA_HOME="/usr/local"

ENV PATH="/root/.local/bin:$XDG_DATA_HOME/venv/bin:$PATH"

# Hardware rootfs overlay
COPY ./userspace/root/etc/ /etc/
COPY ./userspace/root/lib/ /usr/lib/
COPY ./userspace/root/home/ /home/
COPY ./userspace/root/sbin/ /usr/sbin/
COPY ./userspace/root/system/ /system/
COPY ./userspace/root/usr/bin/ /usr/bin/
COPY ./userspace/root/usr/comma/ /usr/comma/
COPY ./userspace/root/usr/lib/ /usr/lib/
COPY ./userspace/root/usr/sbin/ /usr/sbin/
COPY ./userspace/root/usr/share/ /usr/share/

RUN mkdir -p /dsp /firmware /persist /data /cache /rwtmp /root/.config && \
    rm -f /usr/bin/systemctl && \
    ln -sf /usr/comma/shims/systemctl /usr/bin/systemctl && \
    for cmd in init reboot poweroff halt shutdown; do \
      if [ ! "/sbin/$cmd" -ef "/usr/sbin/$cmd" ]; then \
        ln -sf "/usr/sbin/$cmd" "/sbin/$cmd"; \
      fi; \
    done

RUN chown -R "$USERNAME:" "/home/$USERNAME" && \
    rm -rf /root/.config && \
    ln -s "/home/$USERNAME/.config" /root/.config

# Python packages via uv
COPY ./userspace/uv /tmp/agnos/uv
RUN cd /tmp/agnos/uv && \
    export PYOPENCL_CL_PRETEND_VERSION="2.0" && \
    MAKEFLAGS="-j$(nproc)" UV_CONCURRENT_BUILDS=4 UV_NO_CACHE=1 UV_PROJECT_ENVIRONMENT="$XDG_DATA_HOME/venv" \
    uv sync --frozen --inexact --compile-bytecode

# Install kernel headers
COPY ./output/linux-headers/include/ /usr/include/

COPY ./userspace/irsc_util.c /tmp/agnos/
RUN gcc -O2 -Wall -Wextra -o /usr/bin/irsc_util /tmp/agnos/irsc_util.c

COPY ./userspace/power_burn_max.c /tmp/agnos/
RUN gcc -O2 -o "/home/$USERNAME/power_burn_max" /tmp/agnos/power_burn_max.c \
      -L/usr/lib/aarch64-linux-gnu -Wl,-rpath-link,/usr/lib/aarch64-linux-gnu -lOpenCL -lpthread -ldl && \
    chown "$USERNAME:" "/home/$USERNAME/power_burn_max"

RUN chmod 644 /etc/logrotate.conf && \
    chmod 600 /usr/lib/NetworkManager/system-connections/*.nmconnection && \
    rm -f /etc/fstab && \
    mkdir -p /etc/iptables && \
    ln -sf /etc/iptables/rules.v4 /etc/iptables/iptables.rules

# runit owns ModemManager; D-Bus activation would race a second instance.
RUN sed -i 's#^Exec=.*#Exec=/bin/false#' /usr/share/dbus-1/system-services/org.freedesktop.ModemManager1.service

# The journalctl shim reads rsyslog files directly.
RUN sed -i 's/FileCreateMode 0640/FileCreateMode 0644/' /etc/rsyslog.conf

# Prefer ipv4 over ipv6
RUN echo "precedence ::ffff:0:0/96 100" >> /etc/gai.conf

# Make the Ubuntu-style vendor library directory visible to Void's loader.
RUN printf '/usr/lib/aarch64-linux-gnu\n' > /etc/ld.so.conf.d/agnos.conf && \
    for lib in /usr/lib/aarch64-linux-gnu/*.so; do \
      base="${lib##*/}"; \
      [ -e "/usr/lib/$base" ] || ln -s "aarch64-linux-gnu/$base" "/usr/lib/$base"; \
    done && \
    if [ ! -e /usr/lib/libffi.so.6 ]; then \
      ln -sf "$(find /usr/lib /usr/lib/aarch64-linux-gnu -maxdepth 1 -name 'libffi.so.*' ! -name 'libffi.so.6' | sort | head -1)" /usr/lib/libffi.so.6; \
    fi && \
    ldconfig

# Setup RO rootfs
RUN mkdir -p /rwtmp /tmptmp
COPY ./userspace/readonly_setup.sh /tmptmp/readonly_setup.sh
RUN /tmptmp/readonly_setup.sh && rm -rf /tmptmp

# copy version file
COPY VERSION /VERSION

# ################# #
# #### Cleanup #### #
# ################# #

RUN rm -rf /usr/share/icons/* && \
    find /usr/share/locale -maxdepth 1 -mindepth 1 ! -name en_US ! -name en -exec rm -rf {} + && \
    rm -rf /etc/systemd /usr/lib/systemd /lib/systemd \
      /usr/lib/pulseaudio/modules/module-systemd-login.so \
      /usr/lib/resolvconf/systemd-resolved && \
    rm -rf /usr/share/man /usr/share/doc /usr/share/info /var/cache/xbps && \
    rm -rf "/home/$USERNAME/.cache" /root/.cache
