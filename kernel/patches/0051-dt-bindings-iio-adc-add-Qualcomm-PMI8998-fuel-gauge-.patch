From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Adeeb Shihadeh <adeeb@comma.ai>
Date: Sun, 1 Nov 2026 20:07:00 -0800
Subject: [PATCH] dt-bindings: iio: adc: add Qualcomm PMI8998 fuel gauge ADC

Describe the PMI8998 fuel gauge used as a VBAT voltage and current monitor
on boards without a battery, where no fuel gauge algorithm runs, and allow
it as an adc node of the SPMI PMIC.

Signed-off-by: Adeeb Shihadeh <adeeb@comma.ai>
---
 .../bindings/iio/adc/qcom,pmi8998-fg-adc.yaml | 47 +++++++++++++++++++
 .../bindings/mfd/qcom,spmi-pmic.yaml          |  1 +
 2 files changed, 48 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/iio/adc/qcom,pmi8998-fg-adc.yaml

diff --git a/Documentation/devicetree/bindings/iio/adc/qcom,pmi8998-fg-adc.yaml b/Documentation/devicetree/bindings/iio/adc/qcom,pmi8998-fg-adc.yaml
new file mode 100644
index 0000000000..b77e2e61d3
--- /dev/null
+++ b/Documentation/devicetree/bindings/iio/adc/qcom,pmi8998-fg-adc.yaml
@@ -0,0 +1,47 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/iio/adc/qcom,pmi8998-fg-adc.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm PMI8998 fuel-gauge ADC
+
+maintainers:
+  - Adeeb Shihadeh <adeeb@comma.ai>
+
+description: |
+  VBAT voltage and current as measured by the PMI8998 fuel gauge, for boards
+  where VBAT is supplied by a regulator instead of a battery and no fuel gauge
+  algorithm is used. Must not be used together with a fuel gauge driver for
+  the same hardware.
+
+properties:
+  compatible:
+    const: qcom,pmi8998-fg-adc
+
+  reg:
+    maxItems: 1
+
+  '#io-channel-cells':
+    const: 1
+    description: 0 selects VBAT voltage and 1 selects VBAT current.
+
+required:
+  - compatible
+  - reg
+  - '#io-channel-cells'
+
+additionalProperties: false
+
+examples:
+  - |
+    pmic {
+      #address-cells = <1>;
+      #size-cells = <0>;
+
+      adc@4100 {
+        compatible = "qcom,pmi8998-fg-adc";
+        reg = <0x4100>;
+        #io-channel-cells = <1>;
+      };
+    };
diff --git a/Documentation/devicetree/bindings/mfd/qcom,spmi-pmic.yaml b/Documentation/devicetree/bindings/mfd/qcom,spmi-pmic.yaml
index d7a43aa423..9ca497c27c 100644
--- a/Documentation/devicetree/bindings/mfd/qcom,spmi-pmic.yaml
+++ b/Documentation/devicetree/bindings/mfd/qcom,spmi-pmic.yaml
@@ -136,6 +136,7 @@ patternProperties:
   "^adc@[0-9a-f]+$":
     type: object
     oneOf:
+      - $ref: /schemas/iio/adc/qcom,pmi8998-fg-adc.yaml#
       - $ref: /schemas/iio/adc/qcom,spmi-adc5-gen3.yaml#
       - $ref: /schemas/iio/adc/qcom,spmi-iadc.yaml#
       - $ref: /schemas/iio/adc/qcom,spmi-rradc.yaml#
