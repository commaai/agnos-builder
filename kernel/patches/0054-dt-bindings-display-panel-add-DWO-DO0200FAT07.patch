From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Adeeb Shihadeh <adeeb@comma.ai>
Date: Mon, 2 Nov 2026 04:50:53 -0800
Subject: [PATCH] dt-bindings: display: panel: add DWO DO0200FAT07

The DWO DO0200FAT07 is the 240x536 single-lane MIPI DSI LCD panel of the
comma four. It has its own I/O and panel supplies and a reset GPIO, so
it doesn't fit panel-simple-dsi.yaml, which allows a single power
supply. Describe it in its own binding.

Signed-off-by: Adeeb Shihadeh <adeeb@comma.ai>
---
 .../display/panel/dwo,do0200fat07.yaml        | 68 +++++++++++++++++++
 1 file changed, 68 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/display/panel/dwo,do0200fat07.yaml

diff --git a/Documentation/devicetree/bindings/display/panel/dwo,do0200fat07.yaml b/Documentation/devicetree/bindings/display/panel/dwo,do0200fat07.yaml
new file mode 100644
index 0000000000..d67fd56fde
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/panel/dwo,do0200fat07.yaml
@@ -0,0 +1,68 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/panel/dwo,do0200fat07.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: DWO DO0200FAT07 MIPI-DSI LCD panel
+
+maintainers:
+  - Adeeb Shihadeh <adeeb@comma.ai>
+
+description:
+  The DO0200FAT07 from DWO is a 240x536 LCD panel with a single-lane video
+  mode MIPI DSI interface. Its backlight is controlled through DCS commands.
+
+allOf:
+  - $ref: panel-common.yaml#
+
+properties:
+  compatible:
+    const: dwo,do0200fat07
+
+  reg:
+    maxItems: 1
+    description: DSI virtual channel of the peripheral
+
+  vddio-supply:
+    description: I/O supply regulator
+
+  vdd-supply:
+    description: panel supply regulator
+
+required:
+  - compatible
+  - reg
+  - vddio-supply
+  - vdd-supply
+  - reset-gpios
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    dsi {
+      #address-cells = <1>;
+      #size-cells = <0>;
+
+      panel@0 {
+        compatible = "dwo,do0200fat07";
+        reg = <0>;
+
+        vddio-supply = <&vreg_l14a_1p88>;
+        vdd-supply = <&lcd3v3>;
+
+        reset-gpios = <&tlmm 6 GPIO_ACTIVE_LOW>;
+
+        rotation = <90>;
+
+        port {
+          panel_in: endpoint {
+            remote-endpoint = <&mdss_dsi0_out>;
+          };
+        };
+      };
+    };
