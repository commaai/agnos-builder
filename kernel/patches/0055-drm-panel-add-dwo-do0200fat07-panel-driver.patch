From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Robin Reckmann <robin.reckmann@gmail.com>
Date: Thu, 26 Mar 2026 00:24:06 +0900
Subject: [PATCH] drm/panel: add dwo do0200fat07 panel driver

Add support for the dwo do0200fat07 240x536 panel found on the comma mici.

The panel's factory gamma curve differs per unit. Read an optional
150-byte firmware table (comma/dwo-do0200fat07-gamma.bin) containing
three channels of 25 big-endian gamma points, and apply it on each
prepare. The table is loaded once and kept; userspace may only provide
it after the first prepare, so a missing file is looked for again on the
next one. A calibration problem is not fatal: without a usable table,
or if writing it fails, the panel runs with its defaults, with a single
warning.
Panel preparation and backlight updates are serialised so brightness
writes cannot touch the gamma registers while command mode is selected.

[adeeb: squash in per-device gamma calibration, fix Kconfig indentation,
 expand the Kconfig help and fix checkpatch style issues, load the
 calibration once and make a calibration problem non-fatal]
Signed-off-by: Adeeb Shihadeh <adeeb@comma.ai>
---
 drivers/gpu/drm/panel/Kconfig                 |  12 +
 drivers/gpu/drm/panel/Makefile                |   1 +
 drivers/gpu/drm/panel/panel-dwo-do0200fat07.c | 516 ++++++++++++++++++
 3 files changed, 529 insertions(+)
 create mode 100644 drivers/gpu/drm/panel/panel-dwo-do0200fat07.c

diff --git a/drivers/gpu/drm/panel/Kconfig b/drivers/gpu/drm/panel/Kconfig
index cbdf7b8f7f..463ae03553 100644
--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -137,6 +137,18 @@ config DRM_PANEL_CHIPWEALTH_CH13726A
 	  Say Y here if you want to enable support for ChipWealth
 	  CH13726A-based display panels.
 
+config DRM_PANEL_DWO_DO0200FAT07
+	tristate "DWO DO0200FAT07 panel"
+	depends on OF
+	depends on DRM_MIPI_DSI
+	depends on BACKLIGHT_CLASS_DEVICE
+	select VIDEOMODE_HELPERS
+	help
+	  Say Y here if you want to enable support for the DWO DO0200FAT07
+	  240x536 MIPI DSI panel used on the comma four. The driver applies
+	  an optional per-unit gamma calibration, loaded from the firmware
+	  file comma/dwo-do0200fat07-gamma.bin.
+
 config DRM_PANEL_EBBG_FT8719
 	tristate "EBBG FT8719 panel driver"
 	depends on GPIOLIB
diff --git a/drivers/gpu/drm/panel/Makefile b/drivers/gpu/drm/panel/Makefile
index 3b523cf378..ec940570ed 100644
--- a/drivers/gpu/drm/panel/Makefile
+++ b/drivers/gpu/drm/panel/Makefile
@@ -16,6 +16,7 @@ obj-$(CONFIG_DRM_PANEL_DSI_CM) += panel-dsi-cm.o
 obj-$(CONFIG_DRM_PANEL_LVDS) += panel-lvds.o
 obj-$(CONFIG_DRM_PANEL_SIMPLE) += panel-simple.o
 obj-$(CONFIG_DRM_PANEL_EDP) += panel-edp.o
+obj-$(CONFIG_DRM_PANEL_DWO_DO0200FAT07) += panel-dwo-do0200fat07.o
 obj-$(CONFIG_DRM_PANEL_EBBG_FT8719) += panel-ebbg-ft8719.o
 obj-$(CONFIG_DRM_PANEL_ELIDA_KD35T133) += panel-elida-kd35t133.o
 obj-$(CONFIG_DRM_PANEL_FEIXIN_K101_IM2BA02) += panel-feixin-k101-im2ba02.o
diff --git a/drivers/gpu/drm/panel/panel-dwo-do0200fat07.c b/drivers/gpu/drm/panel/panel-dwo-do0200fat07.c
new file mode 100644
index 0000000000..e30bf20240
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-dwo-do0200fat07.c
@@ -0,0 +1,516 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright (c) 2026 Robin Reckmann <robin.reckmann@gmail.com>
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/firmware.h>
+#include <linux/gpio/consumer.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/regulator/consumer.h>
+
+#include <video/mipi_display.h>
+
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_of.h>
+#include <drm/drm_panel.h>
+#include <drm/drm_probe_helper.h>
+
+/* 3 channels, each containing 25 big-endian 16-bit gamma points. */
+#define DWO_GAMMA_FIRMWARE "comma/dwo-do0200fat07-gamma.bin"
+#define DWO_GAMMA_CHANNELS 3
+#define DWO_GAMMA_POINTS 25
+
+static const u8 dwo_gamma_addr[DWO_GAMMA_CHANNELS][DWO_GAMMA_POINTS][2] = {
+	{
+		{ 0x00, 0x01 },
+		{ 0x02, 0x03 },
+		{ 0x04, 0x05 },
+		{ 0x06, 0x07 },
+		{ 0x08, 0x09 },
+		{ 0x0a, 0x0b },
+		{ 0x0c, 0x0d },
+		{ 0x0e, 0x0f },
+		{ 0x10, 0x11 },
+		{ 0x12, 0x13 },
+		{ 0x14, 0x15 },
+		{ 0x16, 0x17 },
+		{ 0x18, 0x19 },
+		{ 0x1a, 0x1b },
+		{ 0x1c, 0x1d },
+		{ 0x1e, 0x1f },
+		{ 0x20, 0x21 },
+		{ 0x22, 0x23 },
+		{ 0x24, 0x25 },
+		{ 0x26, 0x27 },
+		{ 0x28, 0x29 },
+		{ 0x2a, 0x2b },
+		{ 0x2d, 0x2f },
+		{ 0x30, 0x31 },
+		{ 0x32, 0x33 },
+	},
+	{
+		{ 0x34, 0x35 },
+		{ 0x36, 0x37 },
+		{ 0x38, 0x39 },
+		{ 0x3a, 0x3b },
+		{ 0x3d, 0x3f },
+		{ 0x40, 0x41 },
+		{ 0x42, 0x43 },
+		{ 0x44, 0x45 },
+		{ 0x46, 0x47 },
+		{ 0x48, 0x49 },
+		{ 0x4a, 0x4b },
+		{ 0x4c, 0x4d },
+		{ 0x4e, 0x4f },
+		{ 0x50, 0x51 },
+		{ 0x52, 0x53 },
+		{ 0x54, 0x55 },
+		{ 0x56, 0x58 },
+		{ 0x59, 0x5a },
+		{ 0x5b, 0x5c },
+		{ 0x5d, 0x5e },
+		{ 0x5f, 0x60 },
+		{ 0x61, 0x62 },
+		{ 0x63, 0x64 },
+		{ 0x65, 0x66 },
+		{ 0x67, 0x68 },
+	},
+	{
+		{ 0x69, 0x6a },
+		{ 0x6b, 0x6c },
+		{ 0x6d, 0x6e },
+		{ 0x6f, 0x70 },
+		{ 0x71, 0x72 },
+		{ 0x73, 0x74 },
+		{ 0x75, 0x76 },
+		{ 0x77, 0x78 },
+		{ 0x79, 0x7a },
+		{ 0x7b, 0x7c },
+		{ 0x7d, 0x7e },
+		{ 0x7f, 0x80 },
+		{ 0x81, 0x82 },
+		{ 0x83, 0x84 },
+		{ 0x85, 0x86 },
+		{ 0x87, 0x88 },
+		{ 0x89, 0x8a },
+		{ 0x8b, 0x8c },
+		{ 0x8d, 0x8e },
+		{ 0x8f, 0x90 },
+		{ 0x91, 0x92 },
+		{ 0x93, 0x94 },
+		{ 0x95, 0x96 },
+		{ 0x97, 0x98 },
+		{ 0x99, 0x9a },
+	},
+};
+
+struct dwo_do0200fat07 {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct gpio_desc *reset_gpio;
+	struct regulator *vddio;
+	struct regulator *vdd;
+	/* Serialises panel (un)preparation and backlight updates */
+	struct mutex lock;
+	bool prepared;
+	enum drm_panel_orientation orientation;
+	/* The calibration table, once loaded */
+	u8 *gamma;
+	/* No more attempts to load it: loaded, or not usable */
+	bool gamma_done;
+};
+
+static inline struct dwo_do0200fat07 *
+to_dwo_do0200fat07(struct drm_panel *panel)
+{
+	return container_of(panel, struct dwo_do0200fat07, panel);
+}
+
+static void dwo_do0200fat07_reset(struct dwo_do0200fat07 *ctx)
+{
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(1000, 2000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(1000, 2000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(10000, 11000);
+}
+
+static int dwo_do0200fat07_power_on(struct dwo_do0200fat07 *ctx)
+{
+	int ret;
+
+	ret = regulator_enable(ctx->vddio);
+	if (ret)
+		return ret;
+	usleep_range(3000, 5000);
+
+	ret = regulator_enable(ctx->vdd);
+	if (ret) {
+		regulator_disable(ctx->vddio);
+		return ret;
+	}
+	usleep_range(3000, 5000);
+	return 0;
+}
+
+static void dwo_do0200fat07_power_off(struct dwo_do0200fat07 *ctx)
+{
+	regulator_disable(ctx->vdd);
+	regulator_disable(ctx->vddio);
+}
+
+/*
+ * The calibration is written by userspace from the device's persistent
+ * storage, possibly after the first power-on, so a missing file is looked
+ * for again on the next one. Any other problem leaves the panel uncalibrated.
+ */
+static void dwo_do0200fat07_load_gamma(struct dwo_do0200fat07 *ctx)
+{
+	const size_t size = DWO_GAMMA_CHANNELS * DWO_GAMMA_POINTS * 2;
+	struct device *dev = &ctx->dsi->dev;
+	const struct firmware *firmware;
+	int ret;
+
+	if (ctx->gamma_done)
+		return;
+
+	ret = request_firmware_direct(&firmware, DWO_GAMMA_FIRMWARE, dev);
+	if (ret == -ENOENT)
+		return;
+
+	ctx->gamma_done = true;
+	if (ret) {
+		dev_warn(dev, "Failed to load panel gamma: %d\n", ret);
+		return;
+	}
+
+	if (firmware->size == size)
+		ctx->gamma = devm_kmemdup(dev, firmware->data, size, GFP_KERNEL);
+	else
+		dev_warn(dev, "Ignoring invalid panel gamma size: %zu\n",
+			 firmware->size);
+
+	release_firmware(firmware);
+}
+
+static void dwo_do0200fat07_write_gamma(struct dwo_do0200fat07 *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+	const u8 exit_command_mode[] = { 0xfe, 0xa0 };
+	int color, point, ret;
+
+	dwo_do0200fat07_load_gamma(ctx);
+	if (!ctx->gamma)
+		return;
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xfe, 0xa2);
+	for (color = 0; color < DWO_GAMMA_CHANNELS; color++) {
+		for (point = DWO_GAMMA_POINTS - 1; point >= 0; point--) {
+			const u8 *value = &ctx->gamma[(color * DWO_GAMMA_POINTS + point) * 2];
+			u8 command[] = { dwo_gamma_addr[color][point][0], value[0] };
+
+			mipi_dsi_dcs_write_buffer_multi(&dsi_ctx, command, sizeof(command));
+			command[0] = dwo_gamma_addr[color][point][1];
+			command[1] = value[1];
+			mipi_dsi_dcs_write_buffer_multi(&dsi_ctx, command, sizeof(command));
+		}
+	}
+
+	/* Leave command mode even if a gamma write failed. */
+	ret = mipi_dsi_dcs_write_buffer(ctx->dsi, exit_command_mode,
+					sizeof(exit_command_mode));
+	if (ret < 0 && !dsi_ctx.accum_err)
+		dsi_ctx.accum_err = ret;
+	if (dsi_ctx.accum_err)
+		dev_warn_once(&ctx->dsi->dev,
+			      "Failed to write the panel gamma, running uncalibrated: %d\n",
+			      dsi_ctx.accum_err);
+}
+
+static int dwo_do0200fat07_init_sequence(struct dwo_do0200fat07 *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xfe, 0x05);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x91, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x00, 0x00);
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xfe, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x1c, 0x99);
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xfe, 0x00);
+
+	mipi_dsi_dcs_set_pixel_format_multi(&dsi_ctx,
+					    MIPI_DCS_PIXEL_FMT_24BIT |
+					    (MIPI_DCS_PIXEL_FMT_24BIT << 4));
+	mipi_dsi_dcs_set_display_brightness_multi(&dsi_ctx, 0x0000);
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_SET_ADDRESS_MODE, 0x00);
+
+	mipi_dsi_dcs_set_tear_on_multi(&dsi_ctx,
+				       MIPI_DSI_DCS_TEAR_MODE_VHBLANK);
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xc2, 0x03);
+
+	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 100);
+
+	return dsi_ctx.accum_err;
+}
+
+static int dwo_do0200fat07_prepare(struct drm_panel *panel)
+{
+	struct dwo_do0200fat07 *ctx = to_dwo_do0200fat07(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	mutex_lock(&ctx->lock);
+	ret = dwo_do0200fat07_power_on(ctx);
+	if (ret) {
+		dev_err(dev, "Failed to power on: %d\n", ret);
+		goto out;
+	}
+
+	dwo_do0200fat07_reset(ctx);
+
+	ret = dwo_do0200fat07_init_sequence(ctx);
+	if (ret < 0) {
+		dev_err(dev, "Failed to initialize panel: %d\n", ret);
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		dwo_do0200fat07_power_off(ctx);
+		goto out;
+	}
+
+	dwo_do0200fat07_write_gamma(ctx);
+
+	ctx->prepared = true;
+out:
+	mutex_unlock(&ctx->lock);
+	return ret;
+}
+
+static int dwo_do0200fat07_unprepare(struct drm_panel *panel)
+{
+	struct dwo_do0200fat07 *ctx = to_dwo_do0200fat07(panel);
+
+	mutex_lock(&ctx->lock);
+	ctx->prepared = false;
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(1000, 2000);
+	dwo_do0200fat07_power_off(ctx);
+	mutex_unlock(&ctx->lock);
+
+	return 0;
+}
+
+static int dwo_do0200fat07_enable(struct drm_panel *panel)
+{
+	struct dwo_do0200fat07 *ctx = to_dwo_do0200fat07(panel);
+	struct mipi_dsi_multi_context c = { .dsi = ctx->dsi };
+
+	mipi_dsi_dcs_set_display_on_multi(&c);
+	mipi_dsi_msleep(&c, 20);
+
+	return c.accum_err;
+}
+
+static int dwo_do0200fat07_disable(struct drm_panel *panel)
+{
+	struct dwo_do0200fat07 *ctx = to_dwo_do0200fat07(panel);
+	struct mipi_dsi_multi_context c = { .dsi = ctx->dsi };
+
+	mipi_dsi_dcs_set_display_off_multi(&c);
+	mipi_dsi_msleep(&c, 20);
+
+	mipi_dsi_dcs_enter_sleep_mode_multi(&c);
+	mipi_dsi_msleep(&c, 120);
+
+	return c.accum_err;
+}
+
+static const struct drm_display_mode dwo_do0200fat07_mode = {
+	.clock = (240 + 20 + 20 + 40) * (536 + 20 + 4 + 12) * 60 / 1000,
+	.hdisplay = 240,
+	.hsync_start = 240 + 20,
+	.hsync_end = 240 + 20 + 20,
+	.htotal = 240 + 20 + 20 + 40,
+	.vdisplay = 536,
+	.vsync_start = 536 + 20,
+	.vsync_end = 536 + 20 + 4,
+	.vtotal = 536 + 20 + 4 + 12,
+	.width_mm = 20,
+	.height_mm = 44,
+	.type = DRM_MODE_TYPE_DRIVER,
+};
+
+static int dwo_do0200fat07_get_modes(struct drm_panel *panel,
+				     struct drm_connector *connector)
+{
+	struct drm_display_mode *mode;
+
+	mode = drm_mode_duplicate(connector->dev, &dwo_do0200fat07_mode);
+	if (!mode)
+		return -ENOMEM;
+
+	drm_mode_set_name(mode);
+	mode->type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+	drm_mode_probed_add(connector, mode);
+
+	connector->display_info.bpc = 8;
+	connector->display_info.width_mm = dwo_do0200fat07_mode.width_mm;
+	connector->display_info.height_mm = dwo_do0200fat07_mode.height_mm;
+
+	return 1;
+}
+
+static enum drm_panel_orientation
+dwo_do0200fat07_get_orientation(struct drm_panel *panel)
+{
+	struct dwo_do0200fat07 *ctx = to_dwo_do0200fat07(panel);
+
+	return ctx->orientation;
+}
+
+static const struct drm_panel_funcs dwo_do0200fat07_panel_funcs = {
+	.prepare = dwo_do0200fat07_prepare,
+	.unprepare = dwo_do0200fat07_unprepare,
+	.enable = dwo_do0200fat07_enable,
+	.disable = dwo_do0200fat07_disable,
+	.get_modes = dwo_do0200fat07_get_modes,
+	.get_orientation = dwo_do0200fat07_get_orientation,
+};
+
+static int dwo_do0200fat07_bl_update_status(struct backlight_device *bl)
+{
+	struct dwo_do0200fat07 *ctx = bl_get_data(bl);
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	u16 brightness = backlight_get_brightness(bl);
+	int ret = 0;
+
+	mutex_lock(&ctx->lock);
+	if (!ctx->prepared)
+		goto out;
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	ret = mipi_dsi_dcs_set_display_brightness(dsi, brightness);
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+out:
+	mutex_unlock(&ctx->lock);
+	return ret;
+}
+
+static const struct backlight_ops dwo_do0200fat07_bl_ops = {
+	.update_status = dwo_do0200fat07_bl_update_status,
+};
+
+static struct backlight_device *
+dwo_do0200fat07_create_backlight(struct dwo_do0200fat07 *ctx)
+{
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	struct device *dev = &dsi->dev;
+	const struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.brightness = 255,
+		.max_brightness = 255,
+	};
+
+	return devm_backlight_device_register(dev, dev_name(dev), dev, ctx,
+					      &dwo_do0200fat07_bl_ops, &props);
+}
+
+static int dwo_do0200fat07_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct dwo_do0200fat07 *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct dwo_do0200fat07, panel,
+				   &dwo_do0200fat07_panel_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	mutex_init(&ctx->lock);
+	ctx->vddio = devm_regulator_get(dev, "vddio");
+	if (IS_ERR(ctx->vddio))
+		return dev_err_probe(dev, PTR_ERR(ctx->vddio),
+				     "Failed to get vddio-supply\n");
+
+	ctx->vdd = devm_regulator_get(dev, "vdd");
+	if (IS_ERR(ctx->vdd))
+		return dev_err_probe(dev, PTR_ERR(ctx->vdd),
+				     "Failed to get vdd-supply\n");
+
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "Failed to get reset-gpios\n");
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	dsi->lanes = 1;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+			  MIPI_DSI_CLOCK_NON_CONTINUOUS | MIPI_DSI_MODE_LPM;
+
+	ctx->panel.prepare_prev_first = true;
+
+	ctx->panel.backlight = dwo_do0200fat07_create_backlight(ctx);
+	if (IS_ERR(ctx->panel.backlight))
+		return dev_err_probe(dev, PTR_ERR(ctx->panel.backlight),
+				     "Failed to create backlight\n");
+
+	ret = drm_of_get_panel_orientation(dev->of_node, &ctx->orientation);
+	if (ret)
+		return dev_err_probe(dev, ret, "Failed to get orientation\n");
+
+	drm_panel_add(&ctx->panel);
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		drm_panel_remove(&ctx->panel);
+		return dev_err_probe(dev, ret,
+				     "Failed to attach to DSI host\n");
+	}
+
+	return 0;
+}
+
+static void dwo_do0200fat07_remove(struct mipi_dsi_device *dsi)
+{
+	struct dwo_do0200fat07 *ctx = mipi_dsi_get_drvdata(dsi);
+	int ret;
+
+	ret = mipi_dsi_detach(dsi);
+	if (ret < 0)
+		dev_err(&dsi->dev, "Failed to detach from DSI host: %d\n", ret);
+
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id dwo_do0200fat07_of_match[] = {
+	{ .compatible = "dwo,do0200fat07" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, dwo_do0200fat07_of_match);
+
+static struct mipi_dsi_driver dwo_do0200fat07_driver = {
+	.probe = dwo_do0200fat07_probe,
+	.remove = dwo_do0200fat07_remove,
+	.driver = {
+		.name = "panel-dwo-do0200fat07",
+		.of_match_table = dwo_do0200fat07_of_match,
+	},
+};
