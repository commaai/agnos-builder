Subject: [PATCH] clk: qcom: camcc-sdm845: round shared PLL parent rates

The 808 MHz camera PLL runs at 808000195 Hz. Requesting its nominal
rate for another RCG makes CCF reprogram siblings despite the parent
staying at the same achievable rate. Their recalculated rates can then
select the next frequency-table entry and an inactive parent. This also
occurs through the ordinary CSI timer RCGs, not only the shared RCGs.

Return the achievable parent rate while preserving the canonical RCG
frequency. Keep the other operations and non-propagating clocks unchanged.
---
--- a/drivers/clk/qcom/camcc-sdm845.c
+++ b/drivers/clk/qcom/camcc-sdm845.c
@@ -16,6 +16,27 @@
 #include "clk-rcg.h"
 #include "clk-regmap.h"
 #include "gdsc.h"
+
+static struct clk_ops cam_cc_shared_ops;
+static struct clk_ops cam_cc_rcg_ops;
+
+static int cam_cc_determine_rate(struct clk_hw *hw, struct clk_rate_request *req)
+{
+	long parent_rate;
+	int ret;
+
+	ret = clk_rcg2_ops.determine_rate(hw, req);
+	if (ret || !(clk_hw_get_flags(hw) & CLK_SET_RATE_PARENT))
+		return ret;
+
+	/* Avoid reprogramming siblings for the fractional PLL rounding error. */
+	parent_rate = clk_hw_round_rate(req->best_parent_hw, req->best_parent_rate);
+	if (parent_rate < 0)
+		return parent_rate;
+
+	req->best_parent_rate = parent_rate;
+	return 0;
+}
 
 enum {
 	P_BI_TCXO,
