+}
+
+static int gen1_typec_restore_usbin(struct gen1_typec_port *port)
+{
+	int ret;
+
+	if (!port->usbin_saved)
+		return 0;
+
+	ret = regmap_update_bits(port->regmap,
+				 port->base + USBIN_CMD_IL_REG,
+				 USBIN_SUSPEND, port->usbin_restore);
+	if (!ret)
+		port->usbin_saved = false;
 	else
-		ret = port->vbus_enabled || !!(status & TYPEC_VBUS_STATUS);
-	mutex_unlock(&port->lock);
+		dev_err(port->dev, "failed to restore USBIN input state: %d\n", ret);
 
 	return ret;
 }
 
+static int gen1_typec_stop_vbus(struct gen1_typec_port *port)
+{
+	int ret;
+
+	/*
+	 * This dedicated VBUS rail has one consumer. A failed provider enable
+	 * can leave CMD_OTG or its engineering state set without a reference.
+	 * Force the provider's complete disable sequence, even if CMD is off;
+	 * never acquire a reference by enabling a possibly failed source.
+	 */
+	if (!port->vbus_enabled && port->vbus_uncertain) {
+		ret = regulator_force_disable(port->vbus);
+		if (ret)
+			return ret;
+	}
+	if (port->vbus_enabled) {
+		port->vbus_uncertain = true;
+		ret = regulator_disable(port->vbus);
+		if (ret)
+			return ret;
+		port->vbus_enabled = false;
+	}
+	if (port->vbus_uncertain) {
+		ret = regulator_is_enabled(port->vbus);
+		if (ret < 0)
+			return ret;
+		if (ret)
+			return -EBUSY;
+		port->vbus_uncertain = false;
+	}
+	return gen1_typec_restore_usbin(port);
+}
