+			port->usbin_restore = usbin & USBIN_SUSPEND;
+			port->usbin_saved = true;
+		}
 		ret = regulator_enable(port->vbus);
-	else
-		ret = regulator_disable(port->vbus);
-
-	if (!ret) {
-		port->vbus_enabled = on;
+		if (ret) {
