 	mutex_unlock(&port->lock);
@@ -196,6 +311,59 @@
 		tcpm_vbus_change(port->tcpm_port);
 
 	return ret;
+}
+
+static int gen1_typec_vbus_event(struct notifier_block *nb,
+				unsigned long event, void *data)
+{
+	struct gen1_typec_port *port = container_of(nb, struct gen1_typec_port,
+						 vbus_notifier);
+
+	if (!(event & (REGULATOR_EVENT_FAIL | REGULATOR_EVENT_OVER_CURRENT)))
+		return NOTIFY_DONE;
+
+	mutex_lock(&port->lock);
+	port->vbus_fault = true;
+	if (port->tcpm_port)
+		tcpm_port_error_recovery(port->tcpm_port);
+	mutex_unlock(&port->lock);
+	return NOTIFY_OK;
+}
+
+static void gen1_typec_vbus_cleanup(void *data)
+{
+	struct pmic_typec *tcpm = data;
+	struct gen1_typec_port *port = tcpm->pmic_typec_port;
+	int ret;
+
+	/* TCPM teardown already requests source-off; retry an incomplete unwind. */
+	ret = gen1_typec_set_vbus(&tcpm->tcpc, false, false);
+	if (ret)
+		dev_err(port->dev, "failed to clean up VBUS/USBIN state: %d\n", ret);
+}
+
+static int gen1_typec_init_vbus(struct pmic_typec *tcpm)
+{
+	struct gen1_typec_port *port = tcpm->pmic_typec_port;
+	int ret, cleanup;
+
+	if (!port->vbus)
+		return 0;
+
+	ret = regulator_is_enabled(port->vbus);
+	/*
