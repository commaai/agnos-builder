+++ b/Documentation/devicetree/bindings/regulator/qcom,usb-vbus-regulator.yaml
@@ -17,6 +17,9 @@
   The pm8150b variant uses an OTG current-limit selector, supporting limits
   of 500 mA, 1000 mA, 1500 mA, 2000 mA, 2500 mA and 3000 mA.
 
+  The pmi8998 variant has a different OTG current-limit encoding, supporting
+  250 mA through 2000 mA in 250 mA steps.
+
   The pm4125 variant uses a different register layout with a 2-bit VBOOST
   voltage selector supporting output voltages of 4.25 V, 4.5 V, 4.75 V
   and 5.0 V.
@@ -25,6 +28,7 @@
   compatible:
     oneOf:
       - enum:
+          - qcom,pmi8998-vbus-reg
           - qcom,pm8150b-vbus-reg
           - qcom,pm4125-vbus-reg
       - items:
@@ -38,13 +42,35 @@
     maxItems: 1
     description: VBUS output base address
 
+  interrupts:
+    maxItems: 2
+
+  interrupt-names:
+    items:
+      - const: otg-fail
+      - const: otg-overcurrent
+
 allOf:
   - $ref: regulator.yaml#
   - if:
       properties:
         compatible:
           contains:
+            const: qcom,pmi8998-vbus-reg
+    then:
+      required:
