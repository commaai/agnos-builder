diff --git a/drivers/regulator/qcom_usb_vbus-regulator.c b/drivers/regulator/qcom_usb_vbus-regulator.c
--- a/drivers/regulator/qcom_usb_vbus-regulator.c
+++ b/drivers/regulator/qcom_usb_vbus-regulator.c
@@ -12,6 +12,8 @@
 #include <linux/regulator/driver.h>
 #include <linux/regulator/of_regulator.h>
 #include <linux/regmap.h>
+#include <linux/iopoll.h>
+#include <linux/interrupt.h>
 
 #define CMD_OTG				0x40
 #define OTG_EN				BIT(0)
@@ -19,6 +21,17 @@
 #define OTG_CURRENT_LIMIT_MASK		GENMASK(2, 0)
 #define OTG_CFG				0x53
 #define OTG_EN_SRC_CFG			BIT(1)
+#define OTG_ENG_CFG			0xc0
+#define OTG_HALT_1_IN_8			BIT(0)
+#define SEC_ACCESS			0xd0
+#define SEC_UNLOCK			0xa5
+#define OTG_STATUS			0x09
+#define OTG_SOFTSTART_DONE		BIT(3)
+#define OTG_STATE_MASK			GENMASK(2, 0)
+#define OTG_STATE_ENABLED		2
+#define OTG_INT_RT_STS			0x10
+#define OTG_OVERCURRENT			BIT(1)
+#define OTG_FAIL				BIT(0)
 
 #define PM4125_VBOOST_EN		0x50
 #define PM4125_VBOOST_SEL		0x52
@@ -45,6 +58,10 @@
 	500000, 1000000, 1500000, 2000000, 2500000, 3000000,
 };
 
+static const unsigned int pmi8998_curr_table[] = {
+	250000, 500000, 750000, 1000000, 1250000, 1500000, 1750000, 2000000,
+};
+
 static const unsigned int pm4125_vboost_table[] = {
 	4250000, 4500000, 4750000, 5000000,
 };
@@ -68,6 +85,124 @@
 	.ops = &qcom_usb_vbus_reg_ops,
 };
 
+static int pmi8998_halt_1_in_8(struct regulator_dev *rdev, bool halt)
+{
+	unsigned int base = rdev->desc->enable_reg - CMD_OTG;
+	int ret;
+
+	/* The engineering register is protected by the peripheral SEC_ACCESS. */
+	ret = regmap_write(rdev->regmap, base + SEC_ACCESS, SEC_UNLOCK);
+	if (ret)
+		return ret;
+	return regmap_update_bits(rdev->regmap, base + OTG_ENG_CFG,
+				 OTG_HALT_1_IN_8, halt ? OTG_HALT_1_IN_8 : 0);
+}
+
+static int pmi8998_vbus_enable(struct regulator_dev *rdev)
+{
+	unsigned int base = rdev->desc->enable_reg - CMD_OTG;
+	unsigned int status;
+	int ret;
+	int rollback;
+
+	/* SMB2 must leave the low-power buck/boost mode before sourcing VBUS. */
+	ret = pmi8998_halt_1_in_8(rdev, true);
+	if (ret)
+		return ret;
+
+	ret = regulator_enable_regmap(rdev);
+	if (!ret)
+		ret = regmap_read_poll_timeout(rdev->regmap, base + OTG_STATUS,
+					      status,
+					      (status & OTG_SOFTSTART_DONE) &&
+					      (status & OTG_STATE_MASK) == OTG_STATE_ENABLED,
+					      1000, 250000);
+	if (!ret)
+		return 0;
+
+	/* Never report a command write as a completed, usable VBUS transition. */
+	rollback = regulator_disable_regmap(rdev);
+	if (!rollback)
+		rollback = pmi8998_halt_1_in_8(rdev, false);
+	if (rollback)
+		dev_err(&rdev->dev, "failed to roll back VBUS enable: %d\n", rollback);
+	return ret;
+}
+
+static int pmi8998_vbus_disable(struct regulator_dev *rdev)
+{
+	int ret;
+
+	ret = regulator_disable_regmap(rdev);
+	if (ret)
+		return ret;
+
+	return pmi8998_halt_1_in_8(rdev, false);
+}
+
+static int pmi8998_vbus_get_error_flags(struct regulator_dev *rdev,
+				      unsigned int *flags)
+{
+	unsigned int base = rdev->desc->enable_reg - CMD_OTG;
+	unsigned int command, status, fault;
+	int ret;
+
+	*flags = 0;
+	ret = regmap_read(rdev->regmap, base + CMD_OTG, &command);
+	if (ret)
+		return ret;
+	if (!(command & OTG_EN))
+		return 0;
+	ret = regmap_read(rdev->regmap, base + OTG_STATUS, &status);
+	if (ret)
+		return ret;
+	ret = regmap_read(rdev->regmap, base + OTG_INT_RT_STS, &fault);
+	if (ret)
+		return ret;
+	if (fault & OTG_OVERCURRENT)
+		*flags |= REGULATOR_ERROR_OVER_CURRENT;
+	if ((fault & OTG_FAIL) || !(status & OTG_SOFTSTART_DONE) ||
+	    (status & OTG_STATE_MASK) != OTG_STATE_ENABLED)
+		*flags |= REGULATOR_ERROR_FAIL;
+	return 0;
+}
+
+static const struct regulator_ops pmi8998_vbus_reg_ops = {
+	.enable = pmi8998_vbus_enable,
+	.disable = pmi8998_vbus_disable,
+	.is_enabled = regulator_is_enabled_regmap,
+	.get_current_limit = regulator_get_current_limit_regmap,
+	.set_current_limit = regulator_set_current_limit_regmap,
+	.get_error_flags = pmi8998_vbus_get_error_flags,
+};
+
+static const struct qcom_usb_vbus_reg_data pmi8998_data = {
+	.cmd_otg = CMD_OTG,
+	.otg_cfg = OTG_CFG,
+	.otg_en_src_cfg = OTG_EN_SRC_CFG,
+	.csel_reg = OTG_CURRENT_LIMIT_CFG,
+	.csel_mask = OTG_CURRENT_LIMIT_MASK,
+	.curr_table = pmi8998_curr_table,
+	.n_current_limits = ARRAY_SIZE(pmi8998_curr_table),
+	.ops = &pmi8998_vbus_reg_ops,
+};
+
+static irqreturn_t pmi8998_vbus_fail_irq(int irq, void *data)
+{
+	struct regulator_dev *rdev = data;
+
+	regulator_notifier_call_chain(rdev, REGULATOR_EVENT_FAIL, NULL);
+	return IRQ_HANDLED;
+}
+
+static irqreturn_t pmi8998_vbus_oc_irq(int irq, void *data)
+{
+	struct regulator_dev *rdev = data;
+
+	regulator_notifier_call_chain(rdev, REGULATOR_EVENT_OVER_CURRENT, NULL);
+	return IRQ_HANDLED;
+}
+
 static const struct regulator_ops qcom_usb_vbus_pm4125_reg_ops = {
 	.enable = regulator_enable_regmap,
 	.disable = regulator_disable_regmap,
@@ -97,7 +232,7 @@
 	struct regmap *regmap;
 	struct regulator_config config = { };
 	struct regulator_init_data *init_data;
-	int ret;
+	int ret, irq;
 	u32 base;
 
 	ret = of_property_read_u32(dev->of_node, "reg", &base);
@@ -150,20 +285,40 @@
 	config.of_node = dev->of_node;
 	config.regmap = regmap;
 
+	/* Establish software control before consumers can enable the output. */
+	ret = regmap_update_bits(regmap, base + data->otg_cfg,
+				 data->otg_en_src_cfg, 0);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to select software VBUS control\n");
+
 	rdev = devm_regulator_register(dev, rdesc, &config);
 	if (IS_ERR(rdev)) {
 		ret = PTR_ERR(rdev);
 		dev_err(dev, "not able to register vbus reg %d\n", ret);
 		return ret;
 	}
-
-	/* Disable HW logic for VBUS enable */
-	regmap_update_bits(regmap, base + data->otg_cfg, data->otg_en_src_cfg, 0);
+	if (data == &pmi8998_data) {
+		irq = platform_get_irq_byname(pdev, "otg-fail");
+		if (irq < 0)
+			return irq;
+		ret = devm_request_threaded_irq(dev, irq, NULL, pmi8998_vbus_fail_irq,
+						IRQF_ONESHOT, "otg-fail", rdev);
+		if (ret)
+			return ret;
+		irq = platform_get_irq_byname(pdev, "otg-overcurrent");
+		if (irq < 0)
+			return irq;
+		ret = devm_request_threaded_irq(dev, irq, NULL, pmi8998_vbus_oc_irq,
+						IRQF_ONESHOT, "otg-overcurrent", rdev);
+		if (ret)
+			return ret;
+	}
 
 	return 0;
 }
 
 static const struct of_device_id qcom_usb_vbus_regulator_match[] = {
+	{ .compatible = "qcom,pmi8998-vbus-reg", .data = &pmi8998_data },
 	{ .compatible = "qcom,pm8150b-vbus-reg", .data = &pm8150b_data },
 	{ .compatible = "qcom,pm4125-vbus-reg",  .data = &pm4125_data },
 	{ }
diff --git a/drivers/usb/typec/tcpm/qcom/qcom_pmic_typec.c b/drivers/usb/typec/tcpm/qcom/qcom_pmic_typec.c
--- a/drivers/usb/typec/tcpm/qcom/qcom_pmic_typec.c
+++ b/drivers/usb/typec/tcpm/qcom/qcom_pmic_typec.c
@@ -28,6 +28,7 @@
 	const struct pmic_typec_pdphy_resources	*pdphy_res;
 	const struct pmic_typec_port_resources	*port_res;
 	pmic_typec_port_probe_fn	port_probe;
+	void (*port_shutdown)(struct pmic_typec *tcpm);
 };
 
 static int qcom_pmic_typec_init(struct tcpc_dev *tcpc)
@@ -133,17 +134,32 @@
 static void qcom_pmic_typec_remove(struct platform_device *pdev)
 {
 	struct pmic_typec *tcpm = platform_get_drvdata(pdev);
+	const struct pmic_typec_resources *res = of_device_get_match_data(&pdev->dev);
 
 	tcpm->pdphy_stop(tcpm);
 	tcpm->port_stop(tcpm);
 	tcpm_unregister_port(tcpm->tcpm_port);
+	if (res->port_shutdown)
+		res->port_shutdown(tcpm);
 	fwnode_handle_put(tcpm->tcpc.fwnode);
+}
+
+static void qcom_pmic_typec_shutdown(struct platform_device *pdev)
+{
+	const struct pmic_typec_resources *res = of_device_get_match_data(&pdev->dev);
+
+	if (!res->port_shutdown)
+		return;
+
+	/* Stop IRQ/work callbacks and TCPM before forcing the final safe state. */
+	qcom_pmic_typec_remove(pdev);
 }
 
 static const struct pmic_typec_resources gen1_typec_res = {
 	.pdphy_res = &pm8150b_pdphy_res,
 	.port_res = &gen1_port_res,
 	.port_probe = qcom_pmic_typec_gen1_port_probe,
+	.port_shutdown = qcom_pmic_typec_gen1_port_shutdown,
 };
 
 static const struct pmic_typec_resources pm8150b_typec_res = {
@@ -174,6 +190,7 @@
 	},
 	.probe = qcom_pmic_typec_probe,
 	.remove = qcom_pmic_typec_remove,
+	.shutdown = qcom_pmic_typec_shutdown,
 };
 
 module_platform_driver(qcom_pmic_typec_driver);
diff --git a/drivers/usb/typec/tcpm/qcom/qcom_pmic_typec_port_gen1.c b/drivers/usb/typec/tcpm/qcom/qcom_pmic_typec_port_gen1.c
