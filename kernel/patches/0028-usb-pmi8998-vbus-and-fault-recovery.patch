+		ret = regulator_is_enabled(port->vbus);
+		if (ret > 0 && !port->vbus_fault) {
+			ret = regulator_get_error_flags(port->vbus, &errors);
+			ret = ret == -EOPNOTSUPP || ret == -EINVAL ? 1 : !ret && !errors;
+		} else {
