+// the panel's backlight, named after its DSI host
+static const char *find_backlight(void) {
+  static char path[sizeof("/sys/class/backlight/") + sizeof(((struct dirent *)0)->d_name)];
+  DIR *d = opendir("/sys/class/backlight");
+  if (!d) return NULL;
+  struct dirent *ent;
+  const char *found = NULL;
+  while (!found && (ent = readdir(d)) != NULL) {
+    if (ent->d_name[0] == '.') continue;
+    snprintf(path, sizeof(path), "/sys/class/backlight/%s", ent->d_name);
+    found = path;
+  }
+  closedir(d);
+  return found;
+}
