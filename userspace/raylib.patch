From b1cdf6f612a530db45ca83493574201acfb68d8d Mon Sep 17 00:00:00 2001
From: Adeeb Shihadeh <adeeb@comma.ai>
Date: Mon, 2 Nov 2026 01:38:39 -0800
Subject: [PATCH] rlgl: upload GRAY_ALPHA as RG8 with a swizzle on OpenGL ES 3
 contexts

The OpenGL ES 2.0 build maps GRAY_ALPHA to GL_LUMINANCE_ALPHA. That format
isn't color-renderable, so a driver may not be able to generate its
mipmaps by rendering. Mesa's freedreno (Adreno 6xx) falls back to a CPU
box filter that reads the base level through an uncached GPU mapping:
glGenerateMipmap of a 4096x4096 font atlas takes 2.4 s, against 0.1 ms
to queue the GPU blits for RG8.

An ES 2.0 context request can return a later, compatible version, and
Mesa returns ES 3.2. When the context is ES 3.0 or later, upload
GRAY_ALPHA as GL_RG8 and set the texture swizzle to (R, R, R, G). It
samples exactly as LUMINANCE_ALPHA did, with the same memory use, and
its mipmaps are generated on the GPU. ES 2.0 contexts are unchanged.
---
 src/rlgl.h | 52 ++++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 52 insertions(+)

diff --git a/src/rlgl.h b/src/rlgl.h
index 5c6e95af..76723c35 100644
--- a/src/rlgl.h
+++ b/src/rlgl.h
@@ -988,6 +988,25 @@ RLAPI void rlLoadDrawQuad(void);     // Load and draw a quad
         #define GL_READ_FRAMEBUFFER         GL_FRAMEBUFFER
         #define GL_DRAW_FRAMEBUFFER         GL_FRAMEBUFFER
     #endif
+    // OpenGL ES 3.0 tokens, used when the context is ES 3.0 or later
+    #ifndef GL_TEXTURE_SWIZZLE_R
+        #define GL_TEXTURE_SWIZZLE_R        0x8E42
+        #define GL_TEXTURE_SWIZZLE_G        0x8E43
+        #define GL_TEXTURE_SWIZZLE_B        0x8E44
+        #define GL_TEXTURE_SWIZZLE_A        0x8E45
+    #endif
+    #ifndef GL_RED
+        #define GL_RED                      0x1903
+    #endif
+    #ifndef GL_GREEN
+        #define GL_GREEN                    0x1904
+    #endif
+    #ifndef GL_RG
+        #define GL_RG                       0x8227
+    #endif
+    #ifndef GL_RG8
+        #define GL_RG8                      0x822B
+    #endif
 #endif
 
 // Default shader vertex attribute names to set location points
@@ -1125,6 +1144,7 @@ typedef struct rlglData {
         bool texCompASTC;                   // ASTC texture compression support (GL_KHR_texture_compression_astc_hdr, GL_KHR_texture_compression_astc_ldr)
         bool texMirrorClamp;                // Clamp mirror wrap mode supported (GL_EXT_texture_mirror_clamp)
         bool texAnisoFilter;                // Anisotropic texture filtering support (GL_EXT_texture_filter_anisotropic)
+        bool texSwizzle;                    // RG textures and texture swizzle supported (OpenGL ES 3.0 context on an OpenGL ES 2.0 build)
         bool computeShader;                 // Compute shaders support (GL_ARB_compute_shader)
         bool ssbo;                          // Shader storage buffer object support (GL_ARB_shader_storage_buffer_object)
 
@@ -2516,6 +2536,10 @@ void rlLoadExtensions(void *loader)
     for (int i = 0; i < numExt; i++) TRACELOG(RL_LOG_INFO, "    %s", extList[i]);
 #endif
 
+    // An OpenGL ES 2.0 context request can return a later, compatible version (Mesa returns ES 3.2)
+    const char *glVersion = (const char *)glGetString(GL_VERSION);
+    if ((glVersion != NULL) && (strncmp(glVersion, "OpenGL ES ", 10) == 0) && (glVersion[10] >= '3') && (glVersion[10] <= '9')) RLGL.ExtSupported.texSwizzle = true;
+
     // Check required extensions
     for (int i = 0; i < numExt; i++)
     {
@@ -3350,6 +3374,15 @@ unsigned int rlLoadTexture(const void *data, int width, int height, int format,
 #endif
                 glTexParameteriv(GL_TEXTURE_2D, GL_TEXTURE_SWIZZLE_RGBA, swizzleMask);
             }
+#endif
+#if defined(GRAPHICS_API_OPENGL_ES2)
+            if ((format == RL_PIXELFORMAT_UNCOMPRESSED_GRAY_ALPHA) && RLGL.ExtSupported.texSwizzle)
+            {
+                // Sample the RG8 texture as LUMINANCE_ALPHA: (R, R, R, G)
+                glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_SWIZZLE_G, GL_RED);
+                glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_SWIZZLE_B, GL_RED);
+                glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_SWIZZLE_A, GL_GREEN);
+            }
 #endif
         }
 
@@ -3554,6 +3587,15 @@ unsigned int rlLoadTextureCubemap(const void *data, int size, int format, int mi
 #endif
                 glTexParameteriv(GL_TEXTURE_CUBE_MAP, GL_TEXTURE_SWIZZLE_RGBA, swizzleMask);
             }
+#endif
+#if defined(GRAPHICS_API_OPENGL_ES2)
+            if ((format == RL_PIXELFORMAT_UNCOMPRESSED_GRAY_ALPHA) && RLGL.ExtSupported.texSwizzle)
