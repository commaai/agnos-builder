+  // frames are atomic commits of the primary plane's FB_ID
+  drmModePlaneRes *planes = NULL;
+  if (drmSetClientCap(platform.drm.fd, DRM_CLIENT_CAP_ATOMIC, 1) == 0) planes = drmModeGetPlaneResources(platform.drm.fd);
+  for (uint32_t i = 0; planes && i < planes->count_planes && !platform.drm.fb_id_prop; i++) {
+    drmModePlane *plane = drmModeGetPlane(platform.drm.fd, planes->planes[i]);
+    drmModeObjectProperties *props = drmModeObjectGetProperties(platform.drm.fd, planes->planes[i], DRM_MODE_OBJECT_PLANE);
+    bool primary = false;
+    uint32_t fb_id_prop = 0;
+    for (uint32_t j = 0; props && j < props->count_props; j++) {
+      drmModePropertyRes *prop = drmModeGetProperty(platform.drm.fd, props->props[j]);
+      if (strcmp(prop->name, "type") == 0) primary = props->prop_values[j] == DRM_PLANE_TYPE_PRIMARY;
+      if (strcmp(prop->name, "FB_ID") == 0) fb_id_prop = prop->prop_id;
+      drmModeFreeProperty(prop);
+    }
+    if (primary && (plane->possible_crtcs & 1)) {  // res->crtcs[0]
+      platform.drm.plane_id = plane->plane_id;
+      platform.drm.fb_id_prop = fb_id_prop;
+    }
+    drmModeFreeObjectProperties(props);
+    drmModeFreePlane(plane);
+  }
+  drmModeFreePlaneResources(planes);
+  if (!platform.drm.fb_id_prop) {
+    TRACELOG(LOG_WARNING, "COMMA: No atomic primary plane");
+    return -1;
+  }
+
   return 0;
 }
 
