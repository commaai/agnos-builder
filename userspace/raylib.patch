-// show a framebuffer at the next vblank, and wait for it
+// show a framebuffer and wait for it: a blocking atomic commit of the primary plane's FB_ID returns once the
+// frame is latched at vblank, which paces drawing to the panel and frees the buffer shown before. magic hands
+// every client the same DRM file, so a client can't count on reading its own flip events, and a flip queued
+// before the last one completes fails with EBUSY; a blocking commit needs neither
 static bool present_framebuffer(uint32_t framebuffer) {
-  // Closing another client's DRM file can remove the active framebuffer and
-  // disable the CRTC. Restore it when page flipping is no longer possible.
-  if (platform.drm.needs_modeset ||
-      drmModePageFlip(platform.drm.fd, platform.drm.crtc_id, framebuffer, 0, NULL) != 0) {
-    if (!platform.drm.needs_modeset) TRACELOG(LOG_WARNING, "COMMA: Failed to page flip");
+  // when another client of magic's DRM file exits, it removes its framebuffers, and removing the one on
+  // screen disables the CRTC. a plane update can't turn it back on, so that's the normal handover: note it
+  // and modeset. if the modeset fails too, warn once and retry every frame quietly until the display is back
+  bool modeset = platform.drm.needs_modeset;
+  if (!modeset) {
+    drmModeAtomicReq *req = drmModeAtomicAlloc();
+    int ret = req ? drmModeAtomicAddProperty(req, platform.drm.plane_id, platform.drm.fb_id_prop, framebuffer) : -1;
+    if (ret >= 0) ret = drmModeAtomicCommit(platform.drm.fd, req, 0, NULL);
+    drmModeAtomicFree(req);
+    if (ret != 0) {
+      TRACELOG(LOG_INFO, "COMMA: Plane update failed, setting the CRTC");
+      modeset = true;
+    }
+  }
+  if (modeset) {
     if (drmModeSetCrtc(platform.drm.fd, platform.drm.crtc_id, framebuffer, 0, 0, &platform.drm.connector_id, 1, &platform.drm.mode) != 0) {
-      TRACELOG(LOG_WARNING, "COMMA: Failed to set CRTC");
+      if (!platform.drm.display_lost) TRACELOG(LOG_WARNING, "COMMA: Failed to set CRTC: %s", strerror(errno));
+      platform.drm.display_lost = true;
       platform.drm.needs_modeset = true;
       return false;
     }
+    if (platform.drm.display_lost) TRACELOG(LOG_INFO, "COMMA: Display restored");
+    platform.drm.display_lost = false;
     platform.drm.needs_modeset = false;
   }
 
-  static uint32_t vblank_id = 0;
-  drmVBlank v = {0};
-  v.request.type = DRM_VBLANK_RELATIVE;
-  v.request.sequence = 1;
-  drmWaitVBlank(platform.drm.fd, &v);
   if (platform.debug_mode) {
-    if ((v.reply.sequence - vblank_id) > 1) {
-      TRACELOG(LOG_WARNING, "%i FRAME(s) DROPPED!", (v.reply.sequence - vblank_id) - 1);
+    static uint32_t vblank_id = 0;
+    drmVBlank v = {0};
+    v.request.type = DRM_VBLANK_RELATIVE;
+    if (drmWaitVBlank(platform.drm.fd, &v) != 0) {
+      TRACELOG(LOG_WARNING, "COMMA: Reading display sequence failed: %s", strerror(errno));
+    } else {
+      if (vblank_id && (v.reply.sequence - vblank_id) > 1) {
+        TRACELOG(LOG_WARNING, "%i FRAME(s) DROPPED!", (v.reply.sequence - vblank_id) - 1);
+      }
+      vblank_id = v.reply.sequence;
     }
   }
-  vblank_id = v.reply.sequence;
   return true;
 }
 
