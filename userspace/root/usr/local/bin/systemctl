#!/bin/bash
# Compatibility with deployed openpilot and the bundled setup UI.
[ "$(id -u)" = 0 ] || exec sudo -n "$0" "$@"
quiet=0
args=()
for arg in "$@"; do
  case "$arg" in
    -q|--quiet) quiet=1 ;;
    --no-block|--runtime) ;;
    -*) echo "unsupported systemctl option: $arg" >&2; exit 1 ;;
    *) args+=("$arg") ;;
  esac
done
set -- "${args[@]}"
cmd=${1:-}; shift || exit 1
[ "$cmd" = daemon-reload ] && exit 0
[ "$#" -gt 0 ] || exit 1
rc=0
for unit in "$@"; do
  service=${unit%.service}
  case "$service" in
    ssh|ssh.socket) service=sshd ;;
    systemd-timesyncd) service=ntpd ;;
    ModemManager)
      # modem.py used to temporarily disable the old manager.
      case "$cmd" in start|stop|mask|unmask) continue ;; *) exit 3 ;; esac ;;
  esac
  case "$service" in *[!a-zA-Z0-9_.-]*|'') exit 1 ;; esac
  case "$cmd" in
    start|stop|restart|reload|status|try-restart|kill)
      out=$(sv "$cmd" "/etc/service/$service" 2>&1) || rc=$? ;;
    is-active)
      if sv status "/etc/service/$service" 2>/dev/null | grep -q '^run:'; then
        out=active
      else
        out=inactive; rc=3
      fi ;;
    *) echo "unsupported systemctl command: $cmd" >&2; exit 1 ;;
  esac
  [ "$quiet" = 1 ] || [ -z "$out" ] || echo "$out"
done
exit "$rc"
