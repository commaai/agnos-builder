#!/usr/bin/env python3
"""journalctl shim for the runit/rsyslog image.

This is not journald. It translates the journalctl modes openpilot uses to
queries against rsyslog's /var/log/messages.
"""

import json
import os
import re
import subprocess
import sys
import time

LOG_FILE = os.environ.get("JOURNALCTL_LOG_FILE", "/var/log/messages")
SYSLOG_RE = re.compile(r"(\S+)\s+(\S+)\s+([^\[:]+)(?:\[(\d+)\])?:\s*(.*)")


def normalize_unit(unit):
  unit = unit.removesuffix(".service").lower()
  return {
    "ssh": "sshd",
    "networkmanager": "networkmanager",
    "modemmanager": "modemmanager",
  }.get(unit, unit)


def parse_line(line):
  match = SYSLOG_RE.match(line.strip())
  if match is None:
    return None

  return {
    "timestamp": match.group(1),
    "hostname": match.group(2),
    "tag": match.group(3).strip(),
    "pid": match.group(4),
    "message": match.group(5),
  }


def matches_unit(parsed, unit):
  if unit is None:
    return True

  unit = normalize_unit(unit)
  tag = parsed["tag"].lower()
  return tag in {unit, f"runit-{unit}"}


def format_json(parsed):
  entry = {
    "__REALTIME_TIMESTAMP": str(int(time.time() * 1_000_000)),
    "MESSAGE": parsed["message"],
    "SYSLOG_IDENTIFIER": parsed["tag"],
    "_HOSTNAME": parsed["hostname"],
    "PRIORITY": "6",
  }
  if parsed["pid"]:
    entry["_PID"] = parsed["pid"]
  return json.dumps(entry, separators=(",", ":"))


def format_short_monotonic(parsed):
  pid = parsed["pid"] or ""
  return f"{parsed['timestamp']} {parsed['hostname']} {parsed['tag']}[{pid}]: {parsed['message']}"


def format_cat(parsed):
  return parsed["message"]


def parse_args(args):
  follow = False
  output_format = "short"
  unit_filter = None
  lines = None

  i = 0
  while i < len(args):
    arg = args[i]
    if arg in {"-f", "--follow"}:
      follow = True
      i += 1
    elif arg in {"-b", "--boot", "--no-pager", "-x"}:
      i += 1
    elif arg == "-o" and i + 1 < len(args):
      output_format = args[i + 1]
      i += 2
    elif arg.startswith("--output="):
      output_format = arg.split("=", 1)[1]
      i += 1
    elif arg == "-u" and i + 1 < len(args):
      unit_filter = args[i + 1]
      i += 2
    elif arg.startswith("--unit="):
      unit_filter = arg.split("=", 1)[1]
      i += 1
    elif arg == "-n" and i + 1 < len(args):
      lines = int(args[i + 1])
      i += 2
    elif arg.startswith("-n") and len(arg) > 2:
      lines = int(arg[2:])
      i += 1
    elif arg.startswith("--lines="):
      lines = int(arg.split("=", 1)[1])
      i += 1
    else:
      i += 1

  return follow, output_format, unit_filter, lines


def main():
  follow, output_format, unit_filter, lines = parse_args(sys.argv[1:])
  formatters = {
    "json": format_json,
    "short": format_short_monotonic,
    "short-monotonic": format_short_monotonic,
    "cat": format_cat,
  }
  formatter = formatters.get(output_format)
  if formatter is None:
    print(f"journalctl shim: unsupported format '{output_format}'", file=sys.stderr)
    return 1

  if not os.path.exists(LOG_FILE):
    return 0

  if not follow:
    output = []
    with open(LOG_FILE, "r", encoding="utf-8", errors="replace") as source:
      for line in source:
        parsed = parse_line(line)
        if parsed is None or not matches_unit(parsed, unit_filter):
          continue
        output.append(formatter(parsed))

    if lines is not None:
      output = output[-lines:]

    for line in output:
      print(line, flush=True)

    return 0

  cmd = ["tail", "-F", LOG_FILE]
  if lines is not None:
    cmd[1:1] = ["-n", str(lines)]
  proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, text=True)

  try:
    for line in proc.stdout:
      parsed = parse_line(line)
      if parsed is None or not matches_unit(parsed, unit_filter):
        continue
      print(formatter(parsed), flush=True)
  except KeyboardInterrupt:
    pass
  finally:
    proc.terminate()
    proc.wait()

  return 0


if __name__ == "__main__":
  raise SystemExit(main())
