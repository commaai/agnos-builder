[Unit]
Description=Qualcomm remote filesystem service (linux-msm, mainline-kernel only)
Documentation=https://github.com/linux-msm/rmtfs
# Inert on the downstream 4.9 kernel: neither of these paths exists there.
# (the device exposes /dev/qcom_rmtfs_mem1, so match by glob)
ConditionPathExists=/sys/class/remoteproc
ConditionPathExistsGlob=/dev/qcom_rmtfs_mem*

[Service]
Type=simple
# -P auto-discovers the raw EFS partitions via /dev/disk/by-partlabel;
# -r keeps flash strictly read-only (writes go to a RAM shadow).
ExecStart=/usr/bin/rmtfs -r -s -P
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
