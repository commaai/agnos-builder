[Unit]
Description=Qualcomm remote filesystem service
Documentation=https://github.com/linux-msm/rmtfs
ConditionPathExists=/sys/class/remoteproc
ConditionPathExistsGlob=/dev/qcom_rmtfs_mem*

[Service]
Type=simple
ExecStart=/usr/bin/rmtfs -r -s -P
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
