[Unit]
Description=QCOM init
After=sysinit.target
# set the restart levels before any subsystem boots
Before=wifi.service sound.service cdsp.service

[Service]
# ready once the restart levels are set, it then shows as failed if anything after that fails
Type=notify
NotifyAccess=all
RemainAfterExit=true
ExecStart=/usr/comma/init.qcom.sh
StandardOutput=journal+console
TimeoutStopSec=1

[Install]
WantedBy=multi-user.target
