[Unit]
Description=QCOM init
After=sysinit.target
# set the restart levels before any subsystem boots
Before=wifi.service sound.service cdsp.service

[Service]
Type=oneshot
ExecStart=/usr/comma/init.qcom.sh
StandardOutput=journal+console
# only a backstop, init.qcom.sh gives up first and reports what failed
TimeoutStartSec=130
TimeoutStopSec=1

[Install]
WantedBy=multi-user.target
