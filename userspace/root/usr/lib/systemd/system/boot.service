[Unit]
Description=Boot
DefaultDependencies=no
After=local-fs-pre.target
# magic opens a node in debugfs as soon as this is done
After=sys-kernel-debug.mount
Before=local-fs.target
# set the restart levels before any subsystem boots
Before=wifi.service
# the only units before local-fs.target that use /var
Before=systemd-journal-flush.service systemd-random-seed.service

[Service]
# comma and the UI wait for it
Slice=app.slice
Type=oneshot
RemainAfterExit=true
ExecStart=/usr/comma/run_in_app_group.sh /usr/comma/boot.sh
StandardOutput=journal+console
# only a backstop, boot.sh gives up first and reports what failed
TimeoutStartSec=130
TimeoutStopSec=1

[Install]
WantedBy=local-fs.target
