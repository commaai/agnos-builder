# The template binds to the tty's device unit, systemd only gets those from udev
[Unit]
Description=Serial Getty on ttyMSM0
After=systemd-user-sessions.service plymouth-quit-wait.service getty-pre.target
After=rc-local.service
Before=getty.target
IgnoreOnIsolate=yes
Conflicts=rescue.service
Before=rescue.service

[Service]
# With Ubuntu 24.04 (systemd 255) and 4.9 Kernel, the console is not properly
# hung up when the serial getty for ttyMSM0 is started. Force hangup with this.
ExecStartPre=/bin/stty -F /dev/ttyMSM0 hupcl
ExecStart=-/sbin/agetty -o '-p -- \\u' --keep-baud 115200,57600,38400,9600 - $TERM
Type=idle
Restart=always
UtmpIdentifier=ttyMSM0
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/ttyMSM0
TTYReset=yes
TTYVHangup=yes
IgnoreSIGPIPE=no
SendSIGHUP=yes
ImportCredential=agetty.*
ImportCredential=login.*
