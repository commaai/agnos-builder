[Unit]
Description=Populate /usr/lib/firmware for mainline-kernel modem/wifi bring-up
ConditionPathExists=/sys/class/remoteproc
After=comma-init.service
Requires=comma-init.service
Before=rmtfs.service tqftpserv.service pd-mapper.service mss-start.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/comma/setup-mainline-firmware.sh

[Install]
WantedBy=multi-user.target
