[Unit]
After=multi-user.target
# Never give up: this is what protects /data when the car supply drops
StartLimitIntervalSec=0

[Service]
Restart=always
RestartSec=1
ExecCondition=/bin/bash -c 'grep -q tizi /sys/firmware/devicetree/base/model'
# python3-libgpiod is in the system Python
ExecStart=/usr/bin/python3 -u /usr/comma/power_drop_monitor.py

[Install]
WantedBy=multi-user.target
