[Unit]
Description=Give the opted-in openpilot UI first-frame priority
DefaultDependencies=no
After=comma-init.service comma.service magic.service
Requires=comma-init.service comma.service magic.service
Before=basic.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/comma/boot-ui-ready.sh
ExecStopPost=/usr/comma/boot-cpu-cap.sh
TimeoutStartSec=10

[Install]
WantedBy=basic.target
