[Unit]
Description=Uevent helper
# boot fires thousands of uevents, each one would fork the helper
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'echo /usr/comma/uevent_helper.sh > /sys/kernel/uevent_helper'
# Reconcile nodes added between boot.sh's sweep and installing the helper.
ExecStartPost=/usr/comma/uevent_helper.sh --reconcile

[Install]
WantedBy=multi-user.target
