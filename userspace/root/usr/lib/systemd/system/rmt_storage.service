[Unit]
Description=Serve the modem's EFS partitions
Before=init_sys_mss.service

[Service]
ExecStartPre=/usr/comma/wait_for_file.sh /dev/block/bootdevice/by-name/modemst1
ExecStartPre=/usr/comma/wait_for_file.sh /dev/block/bootdevice/by-name/modemst2
ExecStartPre=/usr/comma/wait_for_file.sh /dev/block/bootdevice/by-name/fsc
ExecStartPre=/usr/comma/wait_for_file.sh /dev/block/bootdevice/by-name/fsg
ExecStart=/usr/sbin/rmt_storage
Restart=always

[Install]
WantedBy=multi-user.target
