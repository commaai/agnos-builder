[Unit]
Description=Cellular modem
Wants=lte.service
After=lte.service network.target

[Service]
User=comma
# modem.py's DHCP client for the ECM interface: a packet socket bound to it, and port 68
AmbientCapabilities=CAP_NET_RAW CAP_NET_BIND_SERVICE
ExecStart=/usr/bin/python3 -u /usr/comma/modem.py
ExecStopPost=/usr/bin/rm -f /dev/shm/modem
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
