[Unit]
Description=Qualcomm TFTP-over-QRTR firmware server (linux-msm, mainline-kernel only)
Documentation=https://github.com/andersson/tqftpserv
ConditionPathExists=/sys/class/remoteproc
After=comma-init.service
Requires=comma-init.service

[Service]
Type=simple
# tqftpserv writes uploaded (readwrite) blobs here.
RuntimeDirectory=tqftpserv
StateDirectory=tqftpserv
ExecStart=/usr/bin/tqftpserv
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
