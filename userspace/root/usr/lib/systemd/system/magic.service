[Unit]
Description=Magic
Wants=screen_calibration.service
After=screen_calibration.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=comma

ExecStart=/bin/bash -c "source /etc/profile && /usr/local/venv/bin/python -u /usr/comma/magic.py"
# udev may not have set DRM and backlight permissions yet.
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
