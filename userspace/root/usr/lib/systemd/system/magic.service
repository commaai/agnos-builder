[Unit]
Description=Magic
DefaultDependencies=no
After=boot.service
Before=shutdown.target
Conflicts=shutdown.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=comma
Slice=app.slice
# below 0, so the kernel's OOM killer prefers other processes
OOMScoreAdjust=-500
ExecStart=/usr/comma/run_in_app_group.sh /usr/local/venv/bin/python -u /usr/comma/magic.py
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
