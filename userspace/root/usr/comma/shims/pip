#!/usr/bin/bash

PIP_PATH=/usr/local/venv/bin/pip
export TMPDIR=/tmp/pip-tmp

case "${1:-}" in
  ""|-h|--help|-V|--version|help|version)
    exec "$PIP_PATH" "$@"
    ;;
esac

cleanup() {
  local status=$?
  sudo mount -o ro,remount / >/dev/null 2>&1 || true
  sudo rm -rf "$TMPDIR"
  sudo mount -o remount /tmp >/dev/null 2>&1 || true
  exit "$status"
}
trap cleanup EXIT

# setup large tmp for install
mkdir -p "$TMPDIR"
sudo mount -o remount,size=2G /tmp
sudo mount -o rw,remount /
root_dev="$(findmnt -n -o SOURCE /)"
sudo resize2fs "$root_dev" &>/dev/null || sudo resize2fs "$root_dev"

# run command
sudo TMPDIR="$TMPDIR" PIP_NO_CACHE_DIR=1 "$PIP_PATH" "$@"
