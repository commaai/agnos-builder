#!/bin/bash
exec 2>&1
. /usr/comma/runit/common.sh
last=""
while true; do
  cur="$(cat /data/params/d/AdbEnabled 2>/dev/null || true)"
  if [ "$cur" != "$last" ]; then
    last="$cur"
    log "AdbEnabled changed to ${cur:-unset}"
    sv restart /run/runit/services/adbd 2>/dev/null || true
  fi
  sleep 2
done
