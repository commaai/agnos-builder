#!/bin/bash
exec 2>&1
. /usr/comma/runit/common.sh

networkmanager_running() {
  pgrep -x NetworkManager >/dev/null 2>&1
}

wait_dbus || exit 1
if networkmanager_running; then
  log "watching existing NetworkManager"
  while networkmanager_running; do
    sleep 5
  done
  log "existing NetworkManager exited"
fi

mkdir -p /run/NetworkManager /var/lib/NetworkManager
exec /usr/sbin/NetworkManager --no-daemon
