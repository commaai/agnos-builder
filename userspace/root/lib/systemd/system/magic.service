[Unit]
Description=Magic
DefaultDependencies=no
After=local-fs-pre.target
Before=comma-early.target sysinit.target

[Service]
Type=simple
User=comma
PermissionsStartOnly=true
Environment=XDG_RUNTIME_DIR=/var/tmp/xdg
ExecStartPre=/bin/bash -c "chgrp gpu /dev/adsprpc-smd /dev/ion /dev/kgsl-3d0 /dev/dri/* 2>/dev/null; chmod 660 /dev/adsprpc-smd /dev/kgsl-3d0 /dev/dri/* 2>/dev/null; chmod 664 /dev/ion 2>/dev/null; mkdir -p /data/misc/display 2>/dev/null && echo 0 > /data/misc/display/sdm_dbg_cfg.txt 2>/dev/null && echo 0 > /data/misc/display/gbm_dbg_cfg.txt 2>/dev/null; true"
ExecStart=/usr/local/venv/bin/python -u /usr/comma/magic.py

[Install]
WantedBy=multi-user.target
