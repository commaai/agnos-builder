# /etc/profile: system-wide .profile file for the Bourne shell (sh(1))
# and Bourne compatible shells (bash(1), ksh(1), ash(1), ...).

if [ "${PS1-}" ]; then
  if [ "${BASH-}" ] && [ "$BASH" != "/bin/sh" ]; then
    # The file bash.bashrc already sets the default PS1.
    # PS1='\h:\w\$ '
    if [ -f /etc/bash.bashrc ]; then
      . /etc/bash.bashrc
    fi
  else
    if [ "`id -u`" -eq 0 ]; then
      PS1='# '
    else
      PS1='$ '
    fi
  fi
fi

# PATH and PYTHONPATH live in /etc/environment, which pam_env applies to ssh sessions that never
# read this file. Load it here too for shells started without PAM: comma.sh and adb shell.
set -a
. /etc/environment
set +a

if [ -d /etc/profile.d ]; then
  for i in /etc/profile.d/*.sh; do
    if [ -r $i ]; then
      . $i
    fi
  done
  unset i
fi

# display setup
export XDG_RUNTIME_DIR="/var/tmp/xdg"

# python setup
export CC="${CC:-clang}"
export CXX="${CXX:-clang++}"
export UV_PYTHON_INSTALL_DIR="/usr/local/uv/python"
export UV_PYTHON_PREFERENCE=only-system
export UV_LINK_MODE=copy
# what the venv's activate sets, without putting its bin ahead of the shims
export VIRTUAL_ENV="/usr/local/venv"
export VIRTUAL_ENV_PROMPT="venv"
if [ "${PS1-}" ]; then
  PS1="(venv) ${PS1}"
fi
