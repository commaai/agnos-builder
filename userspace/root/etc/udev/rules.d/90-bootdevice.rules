# Qualcomm tools (rmt_storage, etc.) look up UFS partitions by name here.
# Keep absolute link targets for compatibility with the vendor tools.
SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", ENV{PARTNAME}=="?*", KERNELS=="1d84000.ufshc", ACTION!="remove", RUN+="/bin/sh -c 'mkdir -p /dev/block/bootdevice/by-name && ln -sfn /dev/%k /dev/block/bootdevice/by-name/$env{PARTNAME}'"
