#!/bin/sh
# runit stage 1: one-time system setup (replaces systemd's sysinit + fs_setup
# and serial-hostname). The rootfs is a read-only A/B system partition: never
# fsck or remount it, and keep going when an optional mount fails.
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

mountpoint -q /proc || mount -t proc -o nosuid,noexec,nodev proc /proc
mountpoint -q /sys || mount -t sysfs -o nosuid,noexec,nodev sysfs /sys
mountpoint -q /dev || mount -t devtmpfs -o mode=0755,nosuid devtmpfs /dev
ln -sfn /proc/self/fd /dev/fd
ln -sfn /proc/self/fd/0 /dev/stdin
ln -sfn /proc/self/fd/1 /dev/stdout
ln -sfn /proc/self/fd/2 /dev/stderr
mkdir -p /dev/pts /dev/shm
mountpoint -q /dev/pts || mount -t devpts -o mode=0620,gid=5,nosuid,noexec devpts /dev/pts
mountpoint -q /dev/shm || mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs /dev/shm
mountpoint -q /run || mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run
mkdir -p /run/runit /run/lock /run/resolvconf
touch /run/runit/stopit /run/runit/reboot
chmod 0 /run/runit/stopit /run/runit/reboot
chmod 1777 /run/lock
touch /run/resolv.conf
mountpoint -q /sys/kernel/debug || mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null

mountpoint -q /sys/fs/pstore || mount -t pstore pstore /sys/fs/pstore 2>/dev/null

# Kernel helper covers events until the supervised netlink daemon takes over.
echo /sbin/mdev > /proc/sys/kernel/hotplug
busybox mdev -s
/usr/comma/hotplug.py --coldplug

# Only initialize cache when it has no recognizable filesystem. Never format data.
cache=/dev/disk/by-partlabel/cache
if [ -b "$cache" ] && ! blkid -p "$cache" >/dev/null 2>&1; then
  mkfs.ext4 -F "$cache" || exit 100
fi
echo "AGNOS: mounting filesystems"
mount -a -t nosysfs,nonfs,nonfs4,nosmbfs,nocifs -O no_netdev || echo "AGNOS: mount -a had failures, continuing"

# /var is a tmpfs; repopulate from the build-time copy
for dir in /var /tmp /rwtmp; do
  mountpoint -q "$dir" || exit 100
done
cp -a /usr/default/var/. /var/
echo "AGNOS: fs_setup"
/usr/comma/fs_setup.sh
install -d -o _chrony -g _chrony /data/chrony /run/chrony
/usr/comma/set-hostname.sh || echo "AGNOS: set-hostname failed"

sysctl -q --system
/usr/share/apport/apport --start
ip link set lo up

# Set restart levels before booting any Qualcomm subsystem.
/usr/comma/init.qcom.sh || echo "AGNOS: some subsystem restart levels unavailable"
# Install the cellular firewall before any network service starts.
iptables-restore < /etc/iptables/rules.v4 || exit 100
