 unique_fd daemon_service_to_fd(std::string_view name, atransport* transport) {
     ADB_LOG(Service) << "transport " << transport->serial_name() << " opening service " << name;
+
+#if !defined(__ANDROID__)
+    // AGNOS is Linux: use Linux tools instead of Android's property service.
+    if (name.starts_with("root:")) {
+        return create_service_thread("root", [](unique_fd fd) {
+            WriteFdExactly(fd.get(), "adbd is already running as root\n");
+        });
+    } else if (android::base::ConsumePrefix(&name, "reboot:")) {
+        std::string cmd = "/sbin/reboot";
+        if (!name.empty()) cmd += " -- " + escape_arg(std::string(name));
+        return StartSubprocess(cmd, nullptr, SubprocessType::kRaw, SubprocessProtocol::kNone);
+    } else if (name.starts_with("remount:")) {
+        return StartSubprocess("/bin/mount -o remount,rw /", nullptr, SubprocessType::kRaw,
+                               SubprocessProtocol::kNone);
+    }
+#endif

 #if defined(__ANDROID__) && !defined(__ANDROID_RECOVERY__)
     if (name.starts_with("abb:") || name.starts_with("abb_exec:")) {
